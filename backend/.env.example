# Copy to .env and fill in your real values — NEVER commit .env

PORT=5000
NODE_ENV=development

# MongoDB — get a free URI from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/justhairs?retryWrites=true&w=majority

# Paystack — get these from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend URL (for CORS and Paystack callback redirect)
FRONTEND_URL=http://localhost:5173
